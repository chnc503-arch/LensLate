# Normalize source and docs to LF
*.kt            text eol=lf
*.kts           text eol=lf
*.xml           text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.py            text eol=lf
*.properties    text eol=lf
*.pro           text eol=lf
*.gradle        text eol=lf
*.toml          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Windows scripts need CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binaries
*.jar           binary
*.aar           binary
*.apk           binary
*.aab           binary
*.traineddata   binary
*.png           binary
*.jpg           binary
*.jpeg          binary
